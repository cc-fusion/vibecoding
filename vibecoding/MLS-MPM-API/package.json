{
  "name": "mls-mpm-2d-api-js",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plain JavaScript browser API for a customizable 2D MLS-MPM simulation",
  "browser": "dist/mls-mpm.js",
